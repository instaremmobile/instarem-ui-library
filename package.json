{
  "name": "instarem-ui-library",
  "version": "0.0.2",
  "description": "Custom React component library for form elements",
  "main": "dist/bundle.js",
  "module": "dist/bundle.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maddy8381/instarem-ui-library"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --emitDeclarationOnly && tsc-alias && rollup -c --bundleConfigAsCjs",
    "storybook": "storybook dev -p 6006",
    "storybook-build": "storybook build",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --watch --config jest.config.ts",
    "test:coverage": "jest --coverage --config jest.config.ts",
    "lint": "eslint ./",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit --skipLibCheck",
    "format": "prettier --write src/",
    "precommit": "pretty-quick --staged",
    "prepare": "husky"
  },
  "author": "Shubham Madankar",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "instarem",
    "ui",
    "library"
  ],
  "devDependencies": {
    "@chromatic-com/storybook": "5.0.0",
    "@eslint/js": "9.39.2",
    "@rollup/plugin-babel": "6.1.0",
    "@rollup/plugin-commonjs": "29.0.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "12.3.0",
    "@storybook/addon-docs": "10.1.11",
    "@storybook/addon-links": "10.1.11",
    "@storybook/addon-onboarding": "10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "10.1.11",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "rollup": "4.55.3",
    "rollup-plugin-dts": "^6.3.0",
    "rollup-plugin-ignore": "^1.0.10",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript-paths": "^1.5.0",
    "sass": "^1.97.2",
    "sass-loader": "16.0.6",
    "storybook": "10.1.11",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "@types/lodash": "4.17.23",
    "@typescript-eslint/eslint-plugin": "8.53.1",
    "@typescript-eslint/parser": "8.53.1",
    "lucide-react": "0.562.0",
    "prettier": "^3.8.0",
    "pretty-quick": "^4.2.2",
    "tsc-alias": "^1.8.16",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/lab": "^7.0.1-beta.21",
    "@mui/material": "^7.3.7",
    "@mui/x-date-pickers": "^8.25.0",
    "axios": "1.13.2",
    "clsx": "2.1.1",
    "date-fns": "^4.1.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "lodash": "4.17.21",
    "styled-components": "^6.3.8"
  },
  "pre-commit": [
    "precommit",
    "lint",
    "type-check",
    "test",
    "test:coverage"
  ]
}
